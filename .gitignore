# devenv-managed / local
# .pre-commit-config.yaml is generated by devenv and is a symlink into the nix
# store, so tracking it published a path that exists on one machine.
.pre-commit-config.yaml
.devenv/
.cache/
.env.devenv
.mcp.json
.claude/
.idea/
*.iml

# Environment files. Only .env.devenv was covered, and a repo whose setup
# instructions name an environment variable is one where someone will make a .env.
.env
.env.*

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
*.egg-info/

# test artifacts
.coverage
.coverage.*
htmlcov/

# packaging artifacts
build/
dist/

# Account state: the refresh token, the resolution cache, and the per-spec apply
# ledger. Machine-local by definition; the token is a credential, and the
# resolution cache holds Spotify Content, which the developer terms allow only
# to be cached temporarily and never aggregated into a stored database.
.jukebox/

# Resolutions are never committed, wherever they were written.
data/resolutions/

# Playlist specs are the user's own writing, not this project's content: they
# describe someone's playlists and belong with their data, not in the repo.
specs/

# The chart corpus is a build artifact, rebuilt by `jukebox charts fetch` or the
# fetch_charts tool in seconds. Committing it would republish a machine-readable
# mirror of two decades of a commercial chart compilation, which is a different
# thing from citing the facts it contains. NOTICE.md carries the reasoning.
data/charts/
